{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RotPunktArena",
  "version": "0.1.14",
  "identifier": "de.disag.rotpunktarena",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RotPunktArena",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5QTRBQkRBMzg0MjBERjMKUldUekRVSTQycXVrS1dlM0wxUEQzZTc2UGZ0dWMxK3pUbUNaT2VzRmNaK1g3UTFBNWlZd0RlWTkK",
      "endpoints": [
        "https://github.com/PurePowerPh1l/RotPunktArena/releases/latest/download/latest.json"
      ]
    }
  }
}
