{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RedDot Arena",
  "version": "0.1.0",
  "identifier": "de.disag.reddot.arena",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RedDot Arena",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5QTRBQkRBMzg0MjBERjMKUldUekRVSTQycXVrS1dlM0wxUEQzZTc2UGZ0dWMxK3pUbUNaT2VzRmNaK1g3UTFBNWlZd0RlWTkK",
      "endpoints": [
        "https://github.com/OWNER/reddot-arena/releases/latest/download/latest.json"
      ]
    }
  }
}
